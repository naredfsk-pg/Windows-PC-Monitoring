      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pc-monitor-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pc-monitor-prometheus"
          },
          "expr": "topk(${top_n:raw}, pc_monitor:process_cpu_usage:ratio{instance=\"local\",process=~\"${process:regex}\",process_id=~\"${pid:regex}\"})",
          "legendFormat": "{{process}} / PID {{process_id}}",
          "format": "time_series",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ]
    },
