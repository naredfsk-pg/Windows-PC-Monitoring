{
  "id": null,
  "uid": "pc-monitor-processes",
  "title": "PC Monitor / Process Explorer",
  "description": "Search process/PID, inspect host-capacity CPU and resident/private memory. Names and PIDs are not immutable identities. Excludes command lines and usernames.",
  "tags": [
    "pc-monitor",
    "windows",
    "core"
  ],
  "timezone": "{{TIMEZONE}}",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ],
    "time_options": [
      "1h",
      "6h",
      "24h",
      "7d",
      "30d"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "top_n",
        "label": "Top processes",
        "type": "custom",
        "query": "10,20,50",
        "current": {
          "text": "10",
          "value": "10"
        },
        "options": [
          {
            "text": "10",
            "value": "10",
            "selected": true
          },
          {
            "text": "20",
            "value": "20",
            "selected": false
          },
          {
            "text": "50",
            "value": "50",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "process",
        "label": "Process name",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pc-monitor-prometheus"
        },
        "query": {
          "query": "label_values(windows_process_working_set_bytes{job=\"windows_exporter\",instance=\"local\",process!~\"^(Idle|_Total)$\"}, process)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(windows_process_working_set_bytes{job=\"windows_exporter\",instance=\"local\",process!~\"^(Idle|_Total)$\"}, process)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "pid",
        "label": "PID",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pc-monitor-prometheus"
        },
        "query": {
          "query": "label_values(windows_process_working_set_bytes{job=\"windows_exporter\",instance=\"local\",process=~\"${process:regex}\"}, process_id)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(windows_process_working_set_bytes{job=\"windows_exporter\",instance=\"local\",process=~\"${process:regex}\"}, process_id)",
        "refresh": 1,
        "sort": 3,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/pc-monitor-overview",
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Process Explorer",
      "type": "link",
      "url": "/d/pc-monitor-processes",
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "How to read this dashboard",
      "type": "text",
      "pluginVersion": "13.3.1",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unavailable",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Use the searchable **Process name** and **PID** selectors, then choose Top 10/20/50.\n\n**100% CPU = all host logical CPU capacity.** One busy thread is one core equivalent. CPU rates use two minutes and suppress an observed process restart in that window.\n\n**PID + name is not permanent identity.** Check process start time before interpreting history. Short-lived processes may be missed, and memory slopes across PID reuse are not a leak diagnosis. Top-N limits charts, not stored series."
      }
    },
    {
      "id": 2,
      "title": "Process CPU / host capacity",
      "type": "timeseries",
      "pluginVersion": "13.3.1",
      "description": "Two-minute CPU time divided by host logical processors; 100% means all host capacity.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unavailable",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
