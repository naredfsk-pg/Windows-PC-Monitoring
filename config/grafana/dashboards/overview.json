{
  "id": null,
  "uid": "pc-monitor-overview",
  "title": "PC Monitor / Overview",
  "description": "Local Windows system and process telemetry. Missing telemetry is unavailable, never healthy by default. CPU is scheduled host capacity; sensors are not collected in core.",
  "tags": [
    "pc-monitor",
    "windows",
    "core"
  ],
  "timezone": "{{TIMEZONE}}",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ],
    "time_options": [
      "1h",
      "6h",
      "24h",
      "7d",
      "30d"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/pc-monitor-overview",
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Process Explorer",
      "type": "link",
      "url": "/d/pc-monitor-processes",
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "CPU / host capacity",
      "type": "stat",
      "pluginVersion": "13.3.1",
      "description": "100% is all logical CPU capacity. A two-minute rate needs at least two scrapes.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unavailable",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pc-monitor-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pc-monitor-prometheus"
          },
          "expr": "pc_monitor:cpu_usage:ratio{instance=\"local\"}",
          "legendFormat": "",
          "format": "time_series",
