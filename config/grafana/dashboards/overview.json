    {
      "id": 10,
      "title": "Top 10 processes / host CPU",
      "type": "table",
      "pluginVersion": "13.3.1",
      "description": "Current two-minute CPU rate. 100% is total host capacity. PID reuse guard suppresses rates across an observed start-time change.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 1,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unavailable",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "PID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Inspect this PID",
                    "url": "/d/pc-monitor-processes?var-process=%24__all&var-pid=${__value.raw}&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pc-monitor-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pc-monitor-prometheus"
          },
          "expr": "topk(10, pc_monitor:process_cpu_usage:ratio{instance=\"local\"})",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "indexByName": {
              "process": 0,
              "process_id": 1,
              "Value": 2
            },
            "renameByName": {
              "process": "Process",
              "process_id": "PID"
            }
          }
        }
      ]
    },
